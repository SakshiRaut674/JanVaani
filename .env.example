# ====================
# MAIN APPLICATION CONFIG
# ====================
PORT=3000
NODE_ENV=development

# ====================
# DATABASE CONFIGURATION
# ====================
# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/janvaani

# Redis Configuration
REDIS_URL=redis://localhost:6379

# ====================
# AUTHENTICATION & SECURITY
# ====================
# JWT Secret Key for token signing
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Twilio Configuration for OTP
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# ====================
# AI AND VOICE SERVICES
# ====================
# Google Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Voice Processing Configuration
VOICE_PROCESSING_ENABLED=true
DEFAULT_VOICE_LANGUAGE=en-IN

# ====================
# PAYMENT GATEWAY
# ====================
# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ====================
# EXTERNAL SERVICES
# ====================
# Cloudinary for file uploads
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ====================
# DEVELOPMENT SETTINGS
# ====================
# Set to true for development mode
DEVELOPMENT_MODE=true

# Development OTP (bypasses SMS in dev mode)
DEV_OTP=123456

# Enable debug logging
DEBUG_MODE=true

# ====================
# API CONFIGURATION
# ====================
# Base API URL for internal service calls
BASE_API_URL=http://localhost:3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ====================
# VOICE ASSISTANT SETTINGS
# ====================
# Session timeout in minutes
CHAT_SESSION_TIMEOUT=30

# Maximum message history per session
MAX_MESSAGE_HISTORY=20

# Audio processing settings
MAX_AUDIO_DURATION=300
SUPPORTED_AUDIO_FORMATS=wav,mp3,ogg,webm